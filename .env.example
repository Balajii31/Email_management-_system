# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database Configuration (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# AI Services
AI_PROVIDER=gemini
GOOGLE_GEMINI_API_KEY=your-google-ai-api-key
# Optional backward-compatible alias
GEMINI_API_KEY=your-google-ai-api-key
# Optional: multiple keys for automatic failover (comma-separated)
GEMINI_API_KEYS=key1,key2,key3
# Optional: model preferences
GEMINI_MODEL_PRIMARY=gemini-2.0-flash
GEMINI_MODEL_LIST=gemini-2.0-flash-lite

# xAI (Grok) - used when AI_PROVIDER=grok
XAI_API_KEY=your-xai-api-key
# Optional: multiple xAI keys for failover
XAI_API_KEYS=key1,key2,key3
# Optional: xAI endpoint/model
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest

# Auth Configuration
NEXTAUTH_SECRET=your-random-secret
NEXTAUTH_URL=http://localhost:3000

# Security
ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff # 32 bytes in hex

# Optional: Upstash Redis (for robust rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
